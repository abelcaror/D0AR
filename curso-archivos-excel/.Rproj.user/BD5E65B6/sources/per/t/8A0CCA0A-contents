# ############################################################################
# CLASE 10 — PROTECCIÓN, FILTROS Y VALIDACIÓN DE DATOS
# ############################################################################
# Cómo manejan protección y validación otras librerías:
#   - openxlsx:   protectWorksheet(), dataValidation(), freezePane()... todo disponible
#   - XLConnect:  no soporta validación de datos ni protección desde R
#   - writexl:    no soporta nada de esto
#   - xlsx:       protección básica de hoja, pero sin validación de datos
#
# Sobre filtros y freeze panes:
#   - openxlsx:   setAutoFilter(), freezePane()... equivalentes
#   - XLConnect:  setAutoFilter() disponible, freezePane no
#   - Ninguna librería ligera (writexl, readxl) soporta filtros
#
# Qué vas a aprender:
#   - Proteger hojas (con y sin contraseña)
#   - Añadir autofiltros
#   - Validación de datos (listas desplegables, rangos numéricos)
#   - Congelar paneles (freeze panes)

library(openxlsx2)

# --- Cargamos el archivo de la clase 9 ---
wb <- wb_load("clase09.xlsx")

# --- Hoja "ventas": filtros y freeze ---

# Autofiltros en la cabecera (A:E, incluye la columna "nivel" de la clase 7)
# wb$add_auto_filter("ventas", dims = "A1:E1")
# wb$add_filter("enero", rows = 1, cols = 1:2)

# Congelar la primera fila (cabecera siempre visible al hacer scroll)
wb$freeze_pane("ventas", first_row = TRUE)

# --- Validación: lista desplegable para producto ---
wb$add_data_validation("ventas",
  dims  = "A2:A4",
  type  = "list",
  value = '"Manzanas,Plátanos,Naranjas,Fresas,Uvas"'
)

# --- Validación: cantidad debe ser positiva ---
wb$add_data_validation("ventas",
  dims     = "B2:B4",
  type     = "whole",
  operator = "greaterThan",
  value    = 0
)

# --- Validación: precio entre 0.01 y 100 ---
wb$add_data_validation("ventas",
  dims     = "C2:C4",
  type     = "decimal",
  operator = "between",
  value    = c("0.01", "100")
)

# --- Proteger la hoja de márgenes (datos sensibles) ---
wb$protect_worksheet("margenes", password = "curso2026")

# --- Proteger las hojas de gráficos (que nadie las toque) ---
wb$protect_worksheet("grafico_barras")
wb$protect_worksheet("grafico_lineas")
wb$protect_worksheet("grafico_circular")

# --- Freeze pane en las hojas de meses ---
for (hoja in c("enero", "febrero", "marzo")) {
  wb$freeze_pane(hoja, first_row = TRUE)
}

# --- Freeze pane en resumen ---
wb$freeze_pane("resumen", first_row = TRUE)

wb$save("clase10_final.xlsx")


