data.frame(Parametro  = c$etiqueta,
d_vmax_kmh = round(metrica_vmax(vm)      - mb["vmax"], 1),
d_t100_s   = round(metrica_t100(vm)      - mb["t100"], 1),
d_Q120_l   = round(metrica_Q120(vm)      - mb["Q120"], 2),
d_pend_deg = round(metrica_pendiente(vm)  - mb["pend"], 1))
}))
print(impacto, row.names = FALSE)
