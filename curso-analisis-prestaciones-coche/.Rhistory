# 10.1 Funciones de métricas y sensibilidad
metrica_vmax      <- function(veh) vmax_v(veh)
metrica_t100      <- function(veh) t_evo_v(veh)
metrica_Q120      <- function(veh) consumo_5a(120, veh)
metrica_pendiente <- function(veh) {
F_t     <- veh$T_max * veh$r_marchas[1] * veh$rend_t / veh$R_neum
sin_phi <- (F_t - veh$rho_r * veh$m * veh$g - veh$m * 0.5) / (veh$m * veh$g)
asin(min(max(sin_phi, 0), 1)) * 180 / pi
}
# Barre un parámetro por su rango y devuelve la métrica en cada punto
sensibilidad <- function(param, rango, fn_metrica, veh = veh_base) {
data.frame(
valor   = rango,
metrica = sapply(rango, function(val) {
fn_metrica(enriquecer_vehiculo(modifyList(veh, setNames(list(val), param))))
}),
param   = param
)
}
# Helper: genera un gráfico de sensibilidad con la línea del valor base
p_sens <- function(df, x_base, titulo, eje_x, eje_y, color) {
ggplot(df, aes(x = valor, y = metrica)) +
geom_line(colour = color, linewidth = 1) +
geom_vline(xintercept = x_base, linetype = "dashed", colour = "red") +
labs(title = titulo, x = eje_x, y = eje_y) +
theme_minimal()
}
# 10.2 Curvas de sensibilidad por parámetro
( p_sens(sensibilidad("m",     seq(900,  1600, 50), metrica_vmax),      veh_base$m,     "v_max vs. Masa",    "Masa (kg)",    "km/h",     "steelblue")  |
p_sens(sensibilidad("m",     seq(900,  1600, 50), metrica_t100),      veh_base$m,     "t100 vs. Masa",     "Masa (kg)",    "s",        "darkorange") ) /
( p_sens(sensibilidad("Cx",    seq(0.20, 0.50, 0.02), metrica_vmax),    veh_base$Cx,    "v_max vs. Cx",      "Cx",           "km/h",     "steelblue")  |
p_sens(sensibilidad("Cx",    seq(0.20, 0.50, 0.02), metrica_Q120),    veh_base$Cx,    "Consumo vs. Cx",    "Cx",           "l/100km",  "darkgreen")  ) /
( p_sens(sensibilidad("T_max", seq(150,  380,  10),   metrica_vmax),    veh_base$T_max, "v_max vs. T_max",   "T_max (Nm)",   "km/h",     "steelblue")  |
p_sens(sensibilidad("T_max", seq(150,  380,  10),   metrica_t100),    veh_base$T_max, "t100 vs. T_max",    "T_max (Nm)",   "s",        "darkorange") ) +
plot_annotation(title    = "Sensibilidad de prestaciones a cada parámetro",
subtitle = "Línea roja = valor del vehículo base")
# 10.3 Tabla de impacto: +10% en cada parámetro
candidatos <- list(
list(param = "T_max",  val = veh_base$T_max  * 1.10, etiqueta = "T_max +10%"),
list(param = "m",      val = veh_base$m      * 0.90, etiqueta = "m \u221210%"),
list(param = "Cx",     val = veh_base$Cx     * 0.90, etiqueta = "Cx \u221210%"),
list(param = "rho_r",  val = veh_base$rho_r  * 0.90, etiqueta = "f_r \u221210%"),
list(param = "rend_t", val = min(veh_base$rend_t * 1.10, 1), etiqueta = "rend_t +10%")
)
mb <- c(vmax = metrica_vmax(veh_base), t100 = metrica_t100(veh_base),
Q120 = metrica_Q120(veh_base), pend = metrica_pendiente(veh_base))
